---
layout: layouts/base.njk
title: Support the Team
permalink: /donate-now/
bodyClass: support-page donate-page
---
{% from "macros.njk" import photo %}
<article class="page">
  <header class="page-header">
    <h1>{{ pages.donate.heading | plain | safe }}</h1>
  </header>
  <div class="donate-layout support-section">
    <div>
      <p class="support-prose">{{ pages.donate.text | plain | safe }}</p>
      <a class="button button-dark" href="{{ pages.donate.button | linkHref(site.urls, pages.routes) }}">{{ pages.donate.button.label | plain | safe }}</a>
      <p class="support-note">{{ pages.donate.note | plain | safe }}</p>
    </div>
    <figure class="support-photo">
      {{ photo(pages.donate.photo.id, pages.donate.photo.alt, '', '(max-width: 800px) 100vw, 55vw', true) }}
    </figure>
  </div>
</article>
