---
layout: layouts/base.njk
title: Home
navId: home
bodyClass: home-page
---
{% from "macros.njk" import photo %}
<section class="home-hero" aria-labelledby="home-title">
  <p class="hero-location">{{ pages.home.location | plain | safe }}</p>
  <div class="hero-composition">
    <p class="hero-university">{{ pages.home.university | plain | safe }}</p>
    <h1 id="home-title" class="hero-title"><span>{{ pages.home.titleLine1 | plain | safe }}</span><span>{{ pages.home.titleLine2 | plain | safe }}</span></h1>
    <p class="hero-tagline">{{ pages.home.tagline | plain | safe }}</p>
    <div class="hero-actions"><a class="button button-white" href="{{ pages.home.heroJoin | linkHref(site.urls, pages.routes) }}">{{ pages.home.heroJoin.label | plain | safe }}</a><a class="hero-hub-link" href="{{ pages.home.heroHub | linkHref(site.urls, pages.routes) }}">{{ pages.home.heroHub.label | plain | safe }}</a></div>
  </div>
  <span class="hero-orbit" aria-hidden="true"></span>
  <img class="hero-player" src="/assets/images/quigs-cutout-v1.webp" width="1024" height="1536" alt="Quigs reaching high to catch a disc in a black Indiana jersey" fetchpriority="high">
</section>

<section class="ed-recruit" aria-labelledby="ed-recruit-title">
  <div class="ed-recruit-shell">
    <figure class="ed-lucas"><img src="/assets/images/lucas-editorial-v3-1536.webp" srcset="/assets/images/lucas-editorial-v3-640.webp 640w, /assets/images/lucas-editorial-v3-960.webp 960w, /assets/images/lucas-editorial-v3-1536.webp 1536w" sizes="(max-width: 900px) 100vw, 64vw" width="1536" height="1024" alt="Lucas celebrating with arms spread and the disc held high, in a monochrome motion treatment" loading="lazy" decoding="async"></figure>
    <div class="ed-recruit-intro"><h2 id="ed-recruit-title"><span>{{ pages.home.recruitLead | plain | safe }}</span>{{ pages.home.recruitTitle | plain | safe }}</h2><div class="ed-recruit-actions"><a class="ed-link" href="{{ pages.home.recruitJoin | linkHref(site.urls, pages.routes) }}">{{ pages.home.recruitJoin.label | plain | safe }}</a><a class="ed-link ed-link-secondary" href="{{ pages.home.recruitNew | linkHref(site.urls, pages.routes) }}">{{ pages.home.recruitNew.label | plain | safe }}</a></div></div>
  </div>
</section>

<section class="ed-hub" aria-labelledby="ed-hub-title">
  <div class="ed-hub-main">
    <div class="ed-hub-copy"><h2 id="ed-hub-title">{{ pages.home.hubLine1 | plain | safe }}<br>{{ pages.home.hubLine2 | plain | safe }}</h2><a class="ed-link ed-link-light ed-hub-entry" href="{{ pages.home.hubEntry | linkHref(site.urls, pages.routes) }}">{{ pages.home.hubEntry.label | plain | safe }}</a>
      <nav class="ed-hub-nav" aria-label="{{ pages.home.hubNavLabel | plain | safe }}">{%- for link in pages.home.hubLinks -%}<a href="{{ link | linkHref(site.urls, pages.routes) }}">{{ link.label | plain | safe }}</a>{%- endfor -%}</nav>
    </div>
    <figure class="ed-hub-art"><img class="ed-steppa" src="/assets/images/steppa-editorial-v2-1122.webp" srcset="/assets/images/steppa-editorial-v2-640.webp 640w, /assets/images/steppa-editorial-v2-960.webp 960w, /assets/images/steppa-editorial-v2-1122.webp 1122w" sizes="(max-width: 900px) 100vw, 58vw" width="1122" height="1402" alt="Steppa reaching for the disc in his red number 2 jersey against a monochrome field" loading="lazy" decoding="async"></figure>
  </div>
</section>

<section class="ed-foundation" aria-labelledby="ed-foundation-title">
  <div class="ed-foundation-top"><img class="ed-foundation-mark" src="/assets/images/imuf-logo.webp" width="1000" height="170" alt="{{ site.organization | plain | safe }}" loading="lazy"><h2 id="ed-foundation-title">{{ pages.home.foundationTitle | plain | safe }}</h2></div>
  <div class="ed-foundation-photos">
    <figure class="ed-foundation-image">{{ photo('dsc07017','David, Evan and Rowland standing shoulder to shoulder in red Indiana jerseys','','(max-width: 900px) 100vw, 46vw') }}</figure>
    <figure class="ed-foundation-detail">{{ photo('dsc01536','David talking with coaches beside the field','','(max-width: 900px) 100vw, 46vw') }}</figure>
  </div>
  <div class="ed-foundation-copy">{%- for paragraph in pages.home.foundationParagraphs -%}<p>{{ paragraph | plain | safe }}</p>{%- endfor -%}</div>
  <nav class="ed-foundation-nav" aria-label="{{ pages.home.foundationNavLabel | plain | safe }}">{%- for link in pages.home.foundationLinks -%}<a href="{{ link | linkHref(site.urls, pages.routes) }}">{{ link.label | plain | safe }}</a>{%- endfor -%}<a class="ed-donate" href="{{ site.urls.donate }}">{{ pages.home.foundationDonate | plain | safe }}</a></nav>
</section>

<section class="ed-archive" aria-labelledby="ed-archive-title">
  <div class="ed-archive-layout">
    <h2 id="ed-archive-title" class="ed-archive-heading"><span>{{ pages.home.archiveLine1 | plain | safe }}</span><span>{{ pages.home.archiveLine2 | plain | safe }}</span></h2>
    <div class="ed-archive-art"><img class="ed-collin" src="/assets/images/collin-editorial-v3-1672.webp" srcset="/assets/images/collin-editorial-v3-640.webp 640w, /assets/images/collin-editorial-v3-960.webp 960w, /assets/images/collin-editorial-v3-1672.webp 1672w" sizes="(max-width: 900px) 100vw, 90vw" width="1672" height="941" alt="Collin laying out for the disc, in a cinematic field treatment" loading="lazy" decoding="async"></div>
    <a class="ed-link ed-link-light ed-archive-action" href="{{ pages.home.archiveAction | linkHref(site.urls, pages.routes) }}">{{ pages.home.archiveAction.label | plain | safe }}</a>
  </div>
</section>
