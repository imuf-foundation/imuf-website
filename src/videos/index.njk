---
layout: layouts/base.njk
title: Video Archive
permalink: /videos/
bodyClass: videos-page
---
{% macro videoEntry(item, action) %}
<li class="video-entry">
  <a class="video-link" href="{{ item.url }}">
    {% if item.thumbnail %}
      <span class="video-thumb">
        <img src="{{ item.thumbnail }}" width="{{ item.thumbnailWidth }}" height="{{ item.thumbnailHeight }}" alt="{{ item.thumbnailAlt or '' }}" loading="lazy" decoding="async">
      </span>
    {% endif %}
    <span class="video-title">{{ item.title }}</span>
  </a>
  {% if item.note %}<p class="video-note">{{ item.note }}</p>{% endif %}
  {% if action %}<a class="video-action" href="{{ item.url }}">{{ pages.videos.callahanAction | plain | safe }}</a>{% endif %}
</li>
{% endmacro %}
<article class="page">
  <header class="page-header">
    <p class="eyebrow">{{ pages.videos.eyebrow | loose | safe }}</p>
    <h1>{{ pages.videos.heading | plain | safe }}</h1>
    <p class="lede">{{ pages.videos.lede | plain | safe }}</p>
  </header>
  <div class="filter-bar" data-video-filters role="group" aria-label="Video categories" hidden>
    <button type="button" data-video-filter="Callahan" aria-pressed="false">Callahan</button>
    <button type="button" data-video-filter="Highlights" aria-pressed="false">Highlights</button>
    <button type="button" data-video-filter="Lowlights" aria-pressed="false">Lowlights</button>
  </div>
  <section class="video-panel" data-video-panel="Callahan" aria-labelledby="video-callahan">
    <h2 id="video-callahan">Callahan</h2>
    {% if videos.callahan and videos.callahan.length %}
      <ul class="video-catalog">
        {% for item in videos.callahan %}
          {{ videoEntry(item, videos.callahan.length == 1) | safe }}
        {% endfor %}
      </ul>
    {% else %}
      <p class="content-pending">{{ pages.videos.emptyCallahan | plain | safe }}</p>
    {% endif %}
  </section>
  <section class="video-panel" data-video-panel="Highlights" aria-labelledby="video-highlights">
    <h2 id="video-highlights">Highlights</h2>
    {% if videos.highlights and videos.highlights.length %}
      <ul class="video-catalog">
        {% for item in videos.highlights %}
          {{ videoEntry(item, false) | safe }}
        {% endfor %}
      </ul>
    {% else %}
      <p class="content-pending">{{ pages.videos.emptyHighlights | plain | safe }}</p>
    {% endif %}
  </section>
  <section class="video-panel" data-video-panel="Lowlights" aria-labelledby="video-lowlights">
    <h2 id="video-lowlights">Lowlights</h2>
    {% if videos.lowlights and videos.lowlights.length %}
      <ul class="video-catalog">
        {% for item in videos.lowlights %}
          {{ videoEntry(item, false) | safe }}
        {% endfor %}
      </ul>
    {% else %}
      <p class="content-pending">{{ pages.videos.emptyLowlights | plain | safe }}</p>
    {% endif %}
  </section>
  <p class="video-archive"><a href="{{ pages.videos.archiveLink | linkHref(site.urls, pages.routes) }}">{{ pages.videos.archiveLink.label | plain | safe }}</a></p>
</article>
