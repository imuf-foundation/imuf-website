---
layout: layouts/base.njk
title: Contact
permalink: /contact-us/
bodyClass: support-page contact-page
---
<article class="page">
  <header class="page-header">
    <h1>{{ pages.contact.heading | plain | safe }}</h1>
  </header>
  <div class="contact-layout support-section">
    <div>
      <p class="support-prose">{{ pages.contact.foundationText | plain | safe }}</p>
      <a class="button button-dark" href="{{ pages.contact.foundationButton | linkHref(site.urls, pages.routes) }}">{{ pages.contact.foundationButton.label | plain | safe }}</a>
    </div>
    <div>
      <h2 class="support-subhead">{{ pages.contact.playHeading | plain | safe }}</h2>
      <p class="support-prose">{{ pages.contact.playText | plain | safe }}</p>
      <a class="text-link" href="{{ pages.contact.playLink | linkHref(site.urls, pages.routes) }}">{{ pages.contact.playLink.label | plain | safe }}</a>
    </div>
  </div>
</article>
