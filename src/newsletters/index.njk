---
layout: layouts/base.njk
title: Newsletters
permalink: /newsletters/
bodyClass: support-page newsletters-page
---
<article class="page">
  <header class="page-header">
    <p class="eyebrow">{{ pages.newsletters.eyebrow | loose | safe }}</p>
    <h1>{{ pages.newsletters.heading | plain | safe }}</h1>
  </header>
  <div class="support-section">
    <p class="support-prose">{{ pages.newsletters.introduction | plain | safe }}</p>
    <a class="button button-dark" href="{{ pages.newsletters.archiveButton | linkHref(site.urls, pages.routes) }}">{{ pages.newsletters.archiveButton.label | plain | safe }}</a>
    <p class="support-note">{{ pages.newsletters.note | plain | safe }}</p>
    <a class="text-link" href="{{ pages.newsletters.contactLink | linkHref(site.urls, pages.routes) }}">{{ pages.newsletters.contactLink.label | plain | safe }}</a>
  </div>
</article>
