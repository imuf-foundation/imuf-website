</head><body class="{{ bodyClass or '' }}"><a class="skip-link" href="#main">Skip to content</a>
{% include "partials/header.njk" %}<main id="main" tabindex="-1">{{ content | safe }}</main>{% if navId == 'home' %}{% include "partials/footer-home.njk" %}{% else %}{% include "partials/footer.njk" %}{% endif %}
