<footer class="site-footer"><div class="footer-top"><a href="{{ site.urls.home }}" class="footer-name">{{ pages.footer.nameLine1 | plain | safe }}<br>{{ pages.footer.nameLine2 | plain | safe }}<span aria-hidden="true">.</span></a><div class="footer-right"><div class="footer-signup" role="group" aria-label="{{ pages.footer.signupAriaLabel | plain | safe }}"><label for="footer-newsletter-email">{{ pages.footer.signupLabel | plain | safe }}</label><div class="footer-signup-fields"><input id="footer-newsletter-email" type="email" autocomplete="email" placeholder="{{ pages.footer.emailPlaceholder | plain | safe }}"><button type="button" disabled aria-label="{{ pages.footer.homeSubscribeAriaLabel | plain | safe }}">{{ pages.footer.subscribeLabel | plain | safe }}</button></div></div><a class="footer-newsletter-archive" href="{{ pages.footer.archiveLink | linkHref(site.urls, pages.routes) }}">{{ pages.footer.archiveLink.label | plain | safe }}</a></div></div>
<div class="footer-bottom"><a href="{{ pages.routes[pages.footer.foundationRoute] }}" class="foundation-mark"><img src="/assets/images/imuf-white.webp" width="230" height="39" alt="{{ site.organization | plain | safe }}"></a><nav aria-label="{{ pages.footer.navLabel | plain | safe }}"><a href="{{ site.urls.donate }}">{{ pages.footer.donateLabel | plain | safe }}</a><a href="{{ site.urls.contact }}">{{ pages.footer.contactLabel | plain | safe }}</a><a href="{{ site.urls.store }}">{{ pages.footer.storeLabel | plain | safe }}</a><a href="{{ site.urls.instagram }}">{{ pages.footer.instagramLabel | plain | safe }}</a><a href="{{ site.urls.facebook }}">{{ pages.footer.facebookLabel | plain | safe }}</a><a href="{{ site.urls.x }}">{{ pages.footer.xLabel | plain | safe }}</a></nav></div></footer>
