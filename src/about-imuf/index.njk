---
layout: layouts/base.njk
title: About IMUF
permalink: /about-imuf/
bodyClass: support-page about-page
---
{% from "macros.njk" import photo %}
<article class="page">
  <header class="page-header">
    <p class="eyebrow">{{ pages.about.eyebrow | plain | safe }}</p>
    <h1>{{ pages.about.heading | plain | safe }}</h1>
  </header>
  <div class="about-opening support-section">
    <div class="support-prose">
      {%- for paragraph in pages.about.introduction %}
      <p>{{ paragraph | plain | safe }}</p>
      {%- endfor %}
    </div>
    <figure class="support-photo">
      {{ photo(pages.about.photo.id, pages.about.photo.alt, '', '(max-width: 800px) 100vw, 45vw', true) }}
    </figure>
  </div>
  <ul class="value-list support-section">
    {%- for value in pages.about.values %}
    <li>
      <h2 class="value-label">{{ value.label | plain | safe }}</h2>
      <p>{{ value.text | plain | safe }}</p>
    </li>
    {%- endfor %}
  </ul>
  <nav class="support-links" aria-label="{{ pages.about.linksLabel | plain | safe }}">
    {%- for link in pages.about.links %}
    <a href="{{ link | linkHref(site.urls, pages.routes) }}">{{ link.label | plain | safe }}</a>
    {%- endfor %}
  </nav>
</article>
